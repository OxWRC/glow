# GLOW operator settings. Copy to glow.env and edit.
# Comments go on their own lines only (no inline comments); quote values that contain " #".
# Required keys are marked (required); the rest show their defaults.

# (required) Public domain. The dashboard is served at it, the API at api.<domain>, ODK Central at odk.<domain>.
GLOW_DOMAIN=glow.example.org
# (required) OIDC issuer URL used to verify sign-ins.
GLOW_OIDC_ISSUER=https://login.example.org/realms/glow
# (required) OIDC client ID registered for GLOW.
GLOW_OIDC_CLIENT_ID=glow-dashboard

# TLS handling: acme (Caddy gets certificates itself), files (use GLOW_TLS_CERT_DIR), or off (your own TLS terminator).
GLOW_TLS_MODE=acme
# Directory holding fullchain.pem and privkey.pem when GLOW_TLS_MODE=files. Use an absolute path
# (relative paths in this file are resolved against the directory containing glow.env).
GLOW_TLS_CERT_DIR=/etc/glow/certs
# Contact email for ACME certificate issuance (acme mode).
GLOW_ACME_EMAIL=
# Host port for HTTP.
GLOW_HTTP_PORT=80
# Host port for HTTPS.
GLOW_HTTPS_PORT=443

# Demo deployment with fictional data (true or false).
GLOW_DEMO_MODE=false

# Second stack on the same host (for example a demo beside production): a short name
# (lowercase letters, digits, '-'). Compose project glow-<name>. Cannot change after install.
# Each instance needs its own GLOW_STATE_DIR, GLOW_BACKUP_PATH, GLOW_DOMAIN and ports.
GLOW_INSTANCE=

# Directory for persistent state (databases, logs, certificates).
# With GLOW_INSTANCE set, remove this line (the default becomes /var/lib/glow-<name>) or change it.
GLOW_STATE_DIR=/var/lib/glow
# Existing writable directory where backups are written; use a different disk from GLOW_STATE_DIR.
GLOW_BACKUP_PATH=/srv/glow-backups
# IANA timezone used to define reporting periods.
GLOW_PERIOD_TIMEZONE=Europe/London

# Outbound mail relay for ODK Central and GLOW API key claim links (leave
# GLOW_SMTP_HOST empty to disable; admins then cannot issue API keys).
GLOW_SMTP_HOST=
# SMTP port.
GLOW_SMTP_PORT=587
# Use TLS for the SMTP connection (true or false).
GLOW_SMTP_SECURE=false
# SMTP username.
GLOW_SMTP_USER=
# SMTP password.
GLOW_SMTP_PASSWORD=
# From address for outgoing mail (default no-reply@GLOW_DOMAIN).
GLOW_SMTP_FROM=
